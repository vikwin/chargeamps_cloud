# Charge Amps account used by the CLI and live tests.
# The Home Assistant integration does NOT read this file; configure it in the HA UI.
CHARGEAMPS_EMAIL=you@example.com
CHARGEAMPS_PASSWORD=changeme
# Required. Obtain this key from Charge Amps.
CHARGEAMPS_API_KEY=
CHARGEAMPS_BASE_URL=https://eapi.charge.space

# Optional defaults for CLI commands
CHARGEAMPS_CHARGEPOINT_ID=
CHARGEAMPS_CONNECTOR_ID=1
CHARGEAMPS_RFID=
CHARGEAMPS_RFID_FORMAT=Hex
CHARGEAMPS_RFID_LENGTH=
